# ─────────────────────────────────────────────
# StreakKeeper Configuration
# Copy this file to .env and fill in your own values,
# or just run `node setup.js` to be prompted interactively.
# Never commit your real .env file — it will hold secrets.
# ─────────────────────────────────────────────

# A fine-grained personal access token. Run `node manage.js auth` for
# step-by-step instructions on creating one.
# It needs exactly one permission — Contents: Read and write — on exactly
# one repository: the one below.
GITHUB_TOKEN=

# The GitHub repository StreakKeeper will commit to.
# Example: https://github.com/your-username/streakkeeper-log
GITHUB_REPOSITORY_URL=

# Branch to commit to, and the file StreakKeeper appends a daily entry to.
# The file does not need to exist — StreakKeeper creates it on the first run.
GITHUB_BRANCH_NAME=main
STREAK_LOG_FILE_PATH=streak-log.md

# ── OPTIONAL: Telegram notifications ──
# Leave BOTH blank to run without notifications. StreakKeeper works fine
# either way — you just won't be told if something breaks.
#
# TELEGRAM_CHAT_ID must be NUMERIC (e.g. 123456789, or negative for a group).
# An "@username" is NOT a chat ID and fails with "chat not found" forever.
# To find yours: message your bot, then run `node manage.js telegram-id`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Which time zone defines "today".
# Default: UTC. Leave it alone unless you have a specific reason.
#
# GitHub files a commit onto the contribution graph using the commit's own
# timestamp, and commits created through the API are stamped in UTC unless
# StreakKeeper stamps them itself. Keeping this at UTC therefore guarantees
# StreakKeeper and GitHub always agree on which day a commit landed.
#
# If you set a different zone (e.g. Asia/Kolkata), you MUST also set the
# two commit-author values below so the commit carries that zone's offset.
# StreakKeeper refuses to start otherwise, because the mismatch would show
# up months later as an unexplained gap in your graph.
TIMEZONE=UTC

# Optional commit identity. Leave both blank to have GitHub attribute
# commits to the token's owner — the safest option, and always counted as
# a contribution.
# If you set these, the email MUST be one verified on your GitHub account,
# or the commits will not count toward your contribution graph at all.
GITHUB_COMMIT_AUTHOR_NAME=
GITHUB_COMMIT_AUTHOR_EMAIL=

# Where StreakKeeper stores its logs and completion state.
# Relative paths are resolved from the project root. These defaults are
# almost always fine to leave as-is.
LOG_DIRECTORY=logs
STATE_FILE_PATH=data/state.json

# Retry behavior when a contribution attempt fails partway through.
# RETRY_MAX_ATTEMPTS: how many attempts before giving up for this hour.
# RETRY_BASE_DELAY_MS: base delay (in milliseconds) for exponential backoff.
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY_MS=30000

# DRY_RUN=true simulates a successful contribution without touching
# GitHub at all — logging, Telegram, and state updates all still happen
# normally. Useful for testing the rest of the system safely.
DRY_RUN=false

# DEBUG=true prints extra low-level detail (every API call, retry
# internals) that normal use doesn't need to see.
DEBUG=false
